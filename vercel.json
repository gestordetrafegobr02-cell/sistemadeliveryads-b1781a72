{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-deliverypro-version",
          "value": "1.0.0-live"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!auth|admin|super-admin|onboarding|demo|order-status|pedido|assets/|_next/|favicon.ico|logo.png|manifest.json).*[^/])",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*WhatsApp.*|.*facebookexternalhit.*|.*Twitterbot.*|.*TelegramBot.*|.*Slackbot.*|.*Discordbot.*)"
        }
      ],
      "destination": "https://rxmjjuhibcvqzidgidxp.supabase.co/functions/v1/og-preview?slug=$1"
    },
    {
      "source": "/((?!assets/|favicon.ico|logo.png|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
